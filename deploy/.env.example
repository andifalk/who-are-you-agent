# Copy to deploy/.env; never commit real secrets.
# Build contexts relative to deploy/ (compose-local.yaml only).
TRAVEL_CONTEXT=../travel-domain
EXPENSE_CONTEXT=../expense-domain
INSPECTOR_CONTEXT=../identity-inspector
AGENT_CONTEXT=../travel-agent

# Host ports (all services bind to loopback).
TRAVEL_PORT=18081
EXPENSE_PORT=18082
INSPECTOR_PORT=18090
AGENT_PORT=18085

# Agent credentials, OIDC and MCP configuration.
# Fill GOOGLE_API_KEY, all three client secrets and INSPECTOR_API_KEY.
# Generate INSPECTOR_API_KEY with: openssl rand -hex 32
# INSPECTOR_URL is set to http://inspector:8090 by Compose.
# Use false for direct local HTTP; use true behind an HTTPS reverse proxy.
GOOGLE_API_KEY=
CORPORATE_ISSUER=https://keycloak.agile-dev.de/realms/corporate
TRAVEL_ISSUER=https://keycloak.agile-dev.de/realms/travel
CORPORATE_CLIENT_ID=travel-agent-bff
CORPORATE_CLIENT_SECRET=
TRAVEL_GRANT_CLIENT_ID=travel-agent-grant
TRAVEL_GRANT_CLIENT_SECRET=
INSECURE_CLIENT_ID=travel-agent-overprivileged
INSECURE_CLIENT_SECRET=
TRAVEL_MCP_URL=https://travel.agile-dev.de/mcp
EXPENSE_MCP_URL=https://expense.agile-dev.de/mcp
TRAVEL_AUDIENCE=travel-mcp
EXPENSE_AUDIENCE=expense-mcp
TRAVEL_SCOPES=travel.read travel.book
EXPENSE_SCOPES=expenses.create expenses.read
EXCHANGE_SCOPE=access-travel-domain
EXCHANGE_AUDIENCE=https://keycloak.agile-dev.de/realms/travel
INSPECTOR_API_KEY=
# Enable Inspector buttons that generate synthetic events (no real agent/MCP calls).
INSPECTOR_DEMO_ENABLED=false
SESSION_COOKIE_SECURE=false
GEMINI_MODEL=gemini-2.5-flash
