# Copy to deploy/.env; never commit real secrets.
TRAVEL_CONTEXT=../../travel-domain
EXPENSE_CONTEXT=../../expense-domain
INSPECTOR_CONTEXT=../../identity-inspector
TRAVEL_ISSUER=https://keycloak.agile-dev.de/realms/travel
TRAVEL_AUDIENCE=travel-mcp
EXPENSE_AUDIENCE=expense-mcp
TRAVEL_PORT=18081
EXPENSE_PORT=18082
INSPECTOR_PORT=18090
AGENT_PORT=18085
# Generate with: openssl rand -hex 32
INSPECTOR_API_KEY=REPLACE_WITH_RANDOM_SECRET
